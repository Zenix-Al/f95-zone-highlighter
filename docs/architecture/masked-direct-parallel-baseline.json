  "identityFlow": [
    "thread click creates requestId and ownerTabId",
    "route URL carries f95ue_dd, f95ue_dd_ts, f95ue_dd_req, and f95ue_tab",
    "processing trigger stores requestId and ownerTabId in the shared trigger array",
    "GM_openInTab handle is registered in the originating tab by requestId",
    "download page writes URL identity into session route context",
    "host handler reports success or failure through the flow controller",
    "directDownloadEvent carries targetTabId and requestId",
    "originating listener filters by targetTabId and remote",
    "close-tab event closes only the managed handle registered for requestId"
  ],
  "sharedSurfaces": [
    {
      "key": "f95ue.addon.maskedDirect.processingDownload",
      "owner": "domain/directDownload/processingTrigger.js",
      "operations": [
        "complete-value read",
        "complete-value read-modify-write on create",
        "complete-value read-modify-write on exact clear",
        "complete-value overwrite on broad clear"
      ],
      "race": "lost update"
    },
    {
      "key": "f95ue.addon.maskedDirect.directDownloadEvent",
      "owner": "domain/directDownload/attention.js",
      "operations": [
        "complete-value event write",
        "remote value-change listener read"
      ],
      "race": "global timestamp dedupe can discard an out-of-order sibling result"
    },
    {
      "key": "f95ue_dd_downloadPageCloseDelayMs",
      "owner": "infrastructure/gmStorageAdapter.js",
      "operations": [
        "complete-value overwrite",
        "complete-value read",
        "delete"
      ],
      "race": "last writer wins across requests"
    },
    {
      "key": "f95ue.addon.maskedDirect.routeContext",
      "owner": "ports/routeContextRepository.js",
      "operations": [
        "sessionStorage overwrite",
        "sessionStorage read",
        "sessionStorage delete"
      ],
      "race": "tab-local; one context per managed external tab"
    },
    {
      "key": "f95ue.addon.directDownload.tabId",
      "owner": "domain/directDownload/attention.js",
      "operations": [
        "sessionStorage create-once",
        "sessionStorage read"
      ],
      "race": "tab-local owner identity"
    }
  ],
  "broadCleanupCallers": [
